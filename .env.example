DATABASE_PATH=./data/energytool.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Enable integrated RAG: ai.consultant:answer_turn
AI_FUNCTION=
# Standalone AI module; .env is not loaded automatically by Python scripts.
# Keep source documents and generated indexes outside Git.
AI_KB_PATH=
# Optional prebuilt JSON index; takes precedence over AI_KB_PATH.
AI_INDEX_PATH=
# Model generation is opt-in. Default remains local extractive RAG.
AI_MODE=extractive
# Contest platform injects proxy URL, service key and model ID automatically.
# Local real-model testing: docs/LOCAL_MODEL.md and data/local_model.env.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
AI_LLM_TIMEOUT_SECONDS=25
# Required to read saved leads and to request protected AI diagnostics.
ADMIN_TOKEN=replace_with_random_token
